{
  "name": "local-deals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace apps/api",
    "api:build": "npm run build --workspace apps/api",
    "api:start": "npm run start --workspace apps/api",
    "api:test": "npm run test --workspace apps/api",
    "api:typecheck": "npm run typecheck --workspace apps/api",
    "web:dev": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web",
    "web:typecheck": "npm run typecheck --workspace apps/web",
    "mobile:start": "npm run start --workspace apps/mobile",
    "mobile:android": "npm run android --workspace apps/mobile",
    "mobile:ios": "npm run ios --workspace apps/mobile",
    "mobile:typecheck": "npm run typecheck --workspace apps/mobile"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
